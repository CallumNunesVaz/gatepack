# --- common front end: shared verbatim with C4's golden_prep (§C4) ---
read_verilog -sv /repo/fin_decoder_3to8/generated.v
hierarchy -check -top decoder_3to8
proc; flatten; opt
                              # [R4-5] NO bare `fsm` — see below
select -assert-none t:$mem t:$memrd t:$memwr    # [R4-13] assert, don't hope
techmap; opt
setundef -zero                # [R4-12] BEFORE the split, so both sides match
select -assert-none t:$_DLATCH_* t:$_SR_*       # §9.2 latch ban
write_json /repo/fin_decoder_3to8/premap.json  # [R4-14] provenance capture point (§15.1)
# --- end common front end ---

# --- synchronous backend ---
dfflegalize -cell $_DFF_P_ 01 -cell $_DFF_PN0_ 01 -cell $_DFFSR_PNN_ 01    # [R4-2] explicit; flavours from cells.lib
dfflibmap -liberty /repo/fin_decoder_3to8/cells.lib
abc -liberty /repo/fin_decoder_3to8/cells.lib
clean
stat -liberty /repo/fin_decoder_3to8/cells.lib
write_json /repo/fin_decoder_3to8/mapped.json
write_verilog -noattr /repo/fin_decoder_3to8/mapped.v      # [R4-17] for Icarus (§C4.3)