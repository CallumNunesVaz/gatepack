# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# gatepack build artefacts (§10.3 — not committed)
build/
design.layout.json

# Node / Electron
node_modules/
app/dist/
app/resources/bin/
# Bundled native toolchain (scripts/bundle_toolchain.py) — build artefacts, not
# committed. The data trees must live beside bin/ (yosys/iverilog locate them
# relative to their executables), so each of these is a sibling of bin/.
app/resources/share/
app/resources/x86_64-linux-gnu/

# OS
.DS_Store

# Yosys writes its command history to $HOME/.yosys_history; keep a run whose
# HOME happens to be the repo from polluting the tree.
.yosys_history

# worktree symlinks — bare names, because a `dir/` pattern does not match a
# symlink and one of these got committed once, which pointed it at itself
.venv
node_modules

# scratch build output for real-toolchain runs (kept inside the repo:
# anything under /tmp is outside the sandbox and is auto-rejected)
.gpout/

# Verification and build scratch. `gatepack verify --build X` and
# `build --out X` write here, and running them from the repo root with an
# ad-hoc name is how 1590 generated files once got committed by a `git add -A`.
# Use .gpout/ for scratch; these patterns catch the habit anyway.
/vb_*/
/fv_*/
/fin_*/
/g_*/
/f3_*/
/realbuild*/
/dualout/
/dv*/
/sp/
/pv/
/vx/
