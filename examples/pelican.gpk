%YAML 1.2
---
gatepack: 1
kind: design
clock: {freq_hz: 1, signal: clk, source: OSC}
constraints: {vcc: 3.3}
encoding: one_hot
expressions: {}
initial: STOP
inputs:
  - {name: request, sync: true}
  - {name: hold, sync: true}
name: pelican
output_logic: {traffic_amber: "state == WARN", traffic_green: "state == GO", traffic_red: "state == STOP | state == CROSS | state == CLEAR", walk: "state == CROSS"}
outputs:
  - {name: traffic_red}
  - {name: traffic_amber}
  - {name: traffic_green}
  - {name: walk}
properties:
  - {expr: "!(walk & traffic_green) & !(walk & traffic_amber)", kind: mutex, name: never_walk_with_traffic}
  - {expr: "!(traffic_red & traffic_green) & !(traffic_green & traffic_amber) & !(traffic_red & traffic_amber)", kind: mutex, name: one_traffic_aspect}
reset: {active: low, async_assert: true, signal: rst_n, source: SUPERVISOR, sync_deassert: true}
safe_state: {traffic_amber: 0, traffic_green: 0, traffic_red: 1, walk: 0}
states: [GO, WARN, STOP, CROSS, CLEAR]
timing_model: synchronous
transitions:
  - {from: GO, to: WARN, when: "request & !hold"}
  - {from: GO, to: GO, when: "!request | hold"}
  - {from: WARN, to: STOP, when: "1"}
  - {from: STOP, to: CROSS, when: "!hold"}
  - {from: STOP, to: STOP, when: hold}
  - {from: CROSS, to: CLEAR, when: "1"}
  - {from: CLEAR, to: GO, when: "1"}
---
gatepack: 1
kind: library
parts:
  - {area: 1.0, cell: INV, equivalents: ~, family: AUP, function: "!A", gates_per_pkg: 1, inputs: 1, iq_ua: 0.9, mfrs: "TI;Nexperia;Diodes", package: SOT-353, part_suffix: 1G04, tier: G, tpd_ns: 4.6, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: BUF, equivalents: ~, family: AUP, function: A, gates_per_pkg: 1, inputs: 1, iq_ua: 0.9, mfrs: "TI;Nexperia", package: SOT-353, part_suffix: 1G34, tier: G, tpd_ns: 4.6, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: NAND2, equivalents: ~, family: AUP, function: "!(A&B)", gates_per_pkg: 1, inputs: 2, iq_ua: 0.9, mfrs: "TI;Nexperia;Diodes", package: SOT-353, part_suffix: 1G00, tier: G, tpd_ns: 5.1, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: NAND3, equivalents: ~, family: AUP, function: "!(A&B&C)", gates_per_pkg: 1, inputs: 3, iq_ua: 0.9, mfrs: "TI;Nexperia", package: SOT-353, part_suffix: 1G10, tier: G, tpd_ns: 5.5, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: NOR2, equivalents: ~, family: AUP, function: "!(A|B)", gates_per_pkg: 1, inputs: 2, iq_ua: 0.9, mfrs: "TI;Nexperia", package: SOT-353, part_suffix: 1G02, tier: G, tpd_ns: 5.1, vcc_max: 3.6, vcc_min: 0.8}
