%YAML 1.2
---
gatepack: 1
kind: design
# ---------------------------------------------------------------------------
# Pelican crossing controller — the showcase project (§18.1).
#
# A pedestrian-operated crossing: traffic runs green until someone presses the
# request button, then the lights step down to red, the walk signal runs, and
# traffic is released again. It is the circuit almost everyone has stood in
# front of, which is the point: you can judge whether gatepack got it right
# without reading the specification first.
#
# It is also a deliberate tour of the tool. Every pane of the application has
# something real to show from this one file:
#
#   spec editor        five states and seven guarded transitions
#   truth table        four outputs driven by state, exhaustively checkable
#   schematic          23 mapped cells from a real Yosys run
#   packing / BOM      23 single-gate 74AUP packages with refdes assigned
#   analysis           flop count, static current by tier, against constraints
#   verification       a mutex property that genuinely proves
#
# Synthetic, written for this project (§1.3). Nothing here is derived from any
# real installation, and the timings are nominal rather than to any standard.
# ---------------------------------------------------------------------------
name: pelican
timing_model: synchronous

# A slow clock: a crossing changes on human timescales, and it keeps the
# static-current figure honest for a battery-backed controller.
clock: {signal: clk, freq_hz: 1, source: OSC}

reset:
  signal: rst_n
  active: low
  async_assert: true
  sync_deassert: true
  source: SUPERVISOR

encoding: one_hot

inputs:
  # The button is pressed by a person, so it is asynchronous to the clock and
  # must be synchronised (§9.3) or it can violate setup time and put the state
  # register into a metastable state. gatepack emits the two-flop synchroniser.
  - {name: request, sync: true}
  # A maintenance override, also asynchronous.
  - {name: hold, sync: true}

outputs:
  - {name: traffic_red}
  - {name: traffic_amber}
  - {name: traffic_green}
  - {name: walk}

expressions: {}

states: [GO, WARN, STOP, CROSS, CLEAR]
initial: STOP

transitions:
  # Traffic flows until a pedestrian asks to cross.
  - {from: GO,    to: WARN,  when: "request & !hold"}
  - {from: GO,    to: GO,    when: "!request | hold"}
  # Amber, then all-red before the walk signal - never straight to CROSS.
  - {from: WARN,  to: STOP,  when: "1"}
  - {from: STOP,  to: CROSS, when: "!hold"}
  - {from: STOP,  to: STOP,  when: "hold"}
  # The walk phase, then a clearance phase before traffic is released.
  - {from: CROSS, to: CLEAR, when: "1"}
  - {from: CLEAR, to: GO,    when: "1"}

output_logic:
  # Traffic sees red for the whole crossing sequence, including the clearance
  # phase - releasing traffic the instant the walk signal ends is the classic
  # way to hurt someone still in the road.
  traffic_red: "state == STOP | state == CROSS | state == CLEAR"
  traffic_amber: "state == WARN"
  traffic_green: "state == GO"
  walk: "state == CROSS"

properties:
  # The safety property. If this cannot be proved, the design is not fit to
  # build, and the verification panel says so in a way a green tick cannot.
  - {name: never_walk_with_traffic, kind: mutex, expr: "!(walk & traffic_green) & !(walk & traffic_amber)"}
  # Traffic lights are mutually exclusive - the same obligation a real signal
  # head has, and the one a wiring error would break.
  - {name: one_traffic_aspect, kind: mutex, expr: "!(traffic_red & traffic_green) & !(traffic_green & traffic_amber) & !(traffic_red & traffic_amber)"}

# Where the machine must sit if reset is asserted: traffic stopped, nobody
# invited into the road.
safe_state:
  traffic_red: 1
  traffic_amber: 0
  traffic_green: 0
  walk: 0

constraints:
  vcc: 3.3
---
gatepack: 1
kind: library
parts:
  - {area: 1.0, cell: INV, equivalents: ~, family: AUP, function: "!A", gates_per_pkg: 1, inputs: 1, iq_ua: 0.9, mfrs: "TI;Nexperia;Diodes", package: SOT-353, part_suffix: 1G04, tier: G, tpd_ns: 4.6, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: BUF, equivalents: ~, family: AUP, function: A, gates_per_pkg: 1, inputs: 1, iq_ua: 0.9, mfrs: "TI;Nexperia", package: SOT-353, part_suffix: 1G34, tier: G, tpd_ns: 4.6, vcc_max: 3.6, vcc_min: 0.8}
  - {area: 1.0, cell: NAND2, equivalents: ~, family: AUP, function: "!(A&B)", gates_per_pkg: 1, inputs: 2, iq_ua: 0.9, mfrs: "TI;Nexperia;Diodes", package: SOT-353, part_suffix: 1G00, tier: G, tpd_ns: 5.1, vcc_max: 3.6, vcc_min: 0.8}
