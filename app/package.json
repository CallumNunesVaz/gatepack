{
  "name": "gatepack-app",
  "version": "0.1.0",
  "description": "gatepack desktop application \u2014 a view over CLI-produced artefacts (\u00a75)",
  "homepage": "https://github.com/CallumNunesVaz/gatepack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumNunesVaz/gatepack.git"
  },
  "bugs": {
    "url": "https://github.com/CallumNunesVaz/gatepack/issues"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --linux dir",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "4.6.0",
    "elkjs": "0.9.3",
    "monaco-editor": "0.52.2",
    "netlistsvg": "1.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.10",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  },
  "overrides": {
    "netlistsvg": {
      "elkjs": "0.9.3"
    }
  }
}
